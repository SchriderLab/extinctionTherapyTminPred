// ============================================================
// PHASE C
// Minimal high-throughput two-strike outcome model.
//
// Loads the patient once.
// Uses fixed d1_seed before the switch.
// Uses independent treatment_seed after the switch.
// Logs ONE output row per replicate.
// ============================================================

initialize()
{
    initializeSLiMModelType("nonWF");

    defineConstant("Q", 1000);
    defineConstant("expansion_time", 20);
    defineConstant("treatment_time", 300);
    defineConstant("relapse_cap_factor", 1.5);

    defineConstant(
        "mut_rate",
        base_mut_rate * Q
    );

    defineConstant(
        "fitness_scaling",
        1.0 - patient_turnover
    );

    defineGlobal("treatment_start_cycle", -1);

    defineGlobal("dose_drug_1", 0.0);
    defineGlobal("dose_drug_2", 0.0);

    defineGlobal("current_drug", 0);
    defineGlobal("switched", F);
    defineGlobal("finished_written", F);

    // Used only to prove that this extended rerun exactly
    // reproduces the original trajectory through t=119.
    defineGlobal("N_at_original_horizon", -1);

    defineGlobal("N_pre_switch", -1);
    defineGlobal("mean_R2_eff_pre_switch", -1.0);
    defineGlobal("sd_R2_eff_pre_switch", -1.0);


    initializeMutationType(
        "m1",
        1.0,
        "s",
        "return rlnorm(1, -0.635825624, 0.5);"
    );

    initializeMutationType(
        "m2",
        1.0,
        "s",
        "return rlnorm(1, -0.635825624, 0.5);"
    );

    initializeMutationType(
        "m3",
        1.0,
        "f",
        0.0
    );

    m1.mutationStackPolicy = "s";
    m2.mutationStackPolicy = "s";
    m3.mutationStackPolicy = "f";

    initializeGenomicElementType(
        "g1",
        c(m1,m2,m3),
        c(draw_m1,draw_m2,draw_m3)
    );

    initializeGenomicElement(
        g1,
        0,
        0
    );

    initializeMutationRate(
        mut_rate
    );

    initializeRecombinationRate(
        0.0
    );
}


mutationEffect(m1)
{
    return 1.0;
}

mutationEffect(m2)
{
    return 1.0;
}

mutationEffect(m3)
{
    return 1.0;
}


reproduction()
{
    subpop.addCloned(
        individual
    );
}


fitnessEffect(p1)
{
    R1 =
        individual.sumOfMutationsOfType(m1);

    R2 =
        individual.sumOfMutationsOfType(m2);

    if (R1 > 1.0)
        R1 = 1.0;

    if (R2 > 1.0)
        R2 = 1.0;


    m3_i =
        asInteger(
            individual.countOfMutationsOfType(m3) > 0
        );


    drug1_factor =
        1.0 -
        dose_drug_1 *
        (1.0 - R1) *
        (
            1.0 -
            cross_resistance * m3_i
        );


    drug2_factor =
        1.0 -
        dose_drug_2 *
        (1.0 - R2) *
        (
            1.0 -
            cross_resistance * m3_i
        );


    return (
        drug1_factor *
        drug2_factor
    );
}


function (void) start_second_strike(void)
{
    // D1 path is fixed until this exact point.
    // Only now branch the stochastic outcome.

    setSeed(
        asInteger(
            treatment_seed
        )
    );

    defineGlobal(
        "switched",
        T
    );

    defineGlobal(
        "current_drug",
        2
    );

    defineGlobal(
        "dose_drug_1",
        0.0
    );

    defineGlobal(
        "dose_drug_2",
        dose_drug_2_mono
    );
}


function (void) finish_outcome(string$ status)
{
    if (finished_written)
        return;

    defineGlobal(
        "finished_written",
        T
    );

    N =
        p1.individualCount;

    final_t =
        sim.cycle -
        treatment_start_cycle;

    extinct_i =
        asInteger(
            status == "extinct" |
            status == "pre_switch_extinct"
        );

    relapse_i =
        asInteger(
            status == "relapse" |
            status == "pre_switch_relapse"
        );

    header = c(
        "patient_id",
        "lag",
        "replicate",
        "status",
        "extinct",
        "relapse",
        "switched",
        "final_t",
        "final_N",
        "N_at_original_horizon",
        "N_pre_switch",
        "mean_R2_eff_pre_switch",
        "sd_R2_eff_pre_switch",
        "base_mut_rate",
        "dose_drug_1",
        "dose_drug_2",
        "turnover_rate",
        "draw_m1",
        "draw_m2",
        "draw_m3",
        "cross_resistance",
        "d1_seed",
        "treatment_seed"
    );

    row = c(
        patient_id,
        second_strike_lag,
        replicate_id,
        status,
        extinct_i,
        relapse_i,
        asInteger(switched),
        final_t,
        N,
        N_at_original_horizon,
        N_pre_switch,
        mean_R2_eff_pre_switch,
        sd_R2_eff_pre_switch,
        base_mut_rate,
        dose_drug_1_mono,
        dose_drug_2_mono,
        patient_turnover,
        draw_m1,
        draw_m2,
        draw_m3,
        cross_resistance,
        d1_seed,
        treatment_seed
    );

    writeFile(
        outcome_file,
        paste(header, sep=",")
    );

    writeFile(
        outcome_file,
        paste(row, sep=","),
        append=T
    );

    sim.simulationFinished();
}


1 early()
{
    sim.readFromPopulationFile(
        snapshot_file
    );

    // Every lag and replicate for this patient now starts
    // from precisely the same D1 stochastic continuation.
    setSeed(
        asInteger(d1_seed)
    );

    defineGlobal(
        "treatment_start_cycle",
        sim.cycle
    );

    defineGlobal(
        "current_drug",
        1
    );

    defineGlobal(
        "dose_drug_1",
        dose_drug_1_mono
    );

    defineGlobal(
        "dose_drug_2",
        0.0
    );

    p1.fitnessScaling =
        fitness_scaling;


    switch_cycle =
        sim.cycle +
        asInteger(
            second_strike_lag
        );

    community.registerEarlyEvent(
        NULL,
        "{start_second_strike();}",
        switch_cycle,
        switch_cycle
    );


    // Dummy future event keeps SLiM scheduled.
    community.registerLateEvent(
        NULL,
        "{sim.simulationFinished();}",
        sim.cycle + treatment_time + 1,
        sim.cycle + treatment_time + 1
    );
}


early()
{
    if (exists("p1"))
    {
        p1.fitnessScaling =
            fitness_scaling;
    }
}


late()
{
    if (treatment_start_cycle < 0)
        return;

    t =
        sim.cycle -
        treatment_start_cycle;

    N =
        p1.individualCount;

    // --------------------------------------------------------
    // Original 120-cycle simulation terminated unresolved
    // after logging t=119.  Save the same state here so the
    // rerun can be checked for exact reproducibility.
    // --------------------------------------------------------

    if (t == 119)
    {
        defineGlobal(
            "N_at_original_horizon",
            N
        );
    }


    // --------------------------------------------------------
    // Calculate hidden D2 resistance ONCE:
    // immediately after the last D1 cycle before the switch.
    // --------------------------------------------------------

    if (
        current_drug == 1 &
        t == second_strike_lag - 1
    )
    {
        defineGlobal(
            "N_pre_switch",
            N
        );

        mean_eff = 0.0;
        sd_eff = 0.0;

        if (N > 0)
        {
            inds =
                p1.individuals;

            R2 =
                inds.sumOfMutationsOfType(m2);

            R2[R2 > 1.0] = 1.0;

            m3_i =
                asInteger(
                    inds.countOfMutationsOfType(m3) > 0
                );

            R2_eff =
                1.0 -
                (1.0 - R2) *
                (
                    1.0 -
                    cross_resistance * m3_i
                );

            mean_eff =
                mean(R2_eff);

            var_eff =
                mean(R2_eff * R2_eff) -
                mean_eff * mean_eff;

            if (var_eff < 0.0)
                var_eff = 0.0;

            sd_eff =
                sqrt(var_eff);
        }

        defineGlobal(
            "mean_R2_eff_pre_switch",
            mean_eff
        );

        defineGlobal(
            "sd_R2_eff_pre_switch",
            sd_eff
        );
    }


    if (N == 0)
    {
        if (switched)
            finish_outcome("extinct");
        else
            finish_outcome("pre_switch_extinct");

        return;
    }


    if (
        N >
        relapse_cap_factor *
        (2^expansion_time)
    )
    {
        if (switched)
            finish_outcome("relapse");
        else
            finish_outcome("pre_switch_relapse");

        return;
    }


    if (
        t >=
        treatment_time - 1
    )
    {
        finish_outcome(
            "unresolved"
        );

        return;
    }
}
